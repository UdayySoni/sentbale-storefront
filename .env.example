# Copy to .env.local (local development) or set these in your hosting provider (production).
# Local: start-local.ps1 already created .env.local with DATABASE_URL for the bundled PostgreSQL.

# Required. PostgreSQL connection string. Migrations run automatically on first connection.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5433/sentbale
# Optional: connection pool size per server (default 10).
# DATABASE_POOL=10

# Required in production. The public address(es) of the store, comma-separated, https:// only.
# Forms, checkout and admin saves are accepted only from these origins (and localhost).
# SITE_URL=https://sentbale.com,https://www.sentbale.com
# Let search engines index the store (default false, so a staging site stays private).
# SITE_INDEXABLE=true

# Online payments with Razorpay (https://dashboard.razorpay.com → Account & Settings → API keys).
# Use rzp_test_… keys first. With keys set, checkout offers online payment.
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxx
# Required with Razorpay: the secret of the webhook pointing at https://YOUR-DOMAIN/api/payments/razorpay/webhook
# (events: payment.captured, order.paid).
# RAZORPAY_WEBHOOK_SECRET=xxxxxxxx
# The test checkout (orders marked Paid, no money taken). Locally it is on while Razorpay is not configured;
# in production it is off unless this is true. Use it only on a staging site, never on the live store.
# PAYMENTS_ALLOW_TEST=false
# Minutes an unpaid online order holds its stock (5–1440, default 30).
# ORDER_HOLD_MINUTES=30

# Email with Resend (https://resend.com): order confirmations, store alerts, invitations, password resets.
# Without these, emails are only recorded in the outbox table (and reset links printed to the dev console).
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=SENTBALE <orders@sentbale.com>

# Required in production before the owner account exists: a secret of 12+ characters that the
# first-time setup form at /admin asks for, so nobody else can claim a fresh deployment.
# ADMIN_SETUP_CODE=choose-a-long-random-phrase

# Where uploaded images are stored (default data/media). Use a persistent disk in production.
# MEDIA_DIR=/app/data/media
